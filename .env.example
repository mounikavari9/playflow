# Example local environment. Copy to .env (gitignored) and adjust.
# These are development-only values. Never put real credentials here.

# --- docker compose (PostgreSQL) ---
POSTGRES_USER=playflow
POSTGRES_PASSWORD=playflow
POSTGRES_DB=playflow
POSTGRES_PORT=5432

# --- API (backend) ---
APP_ENV=local
PORT=8080
DATABASE_URL=postgres://playflow:playflow@localhost:5432/playflow?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
