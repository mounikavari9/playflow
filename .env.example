# Example local environment. Copy to .env (gitignored) and adjust.
# These are development-only values. Never put real credentials here.
#
# Docker Compose reads .env automatically. Host-run Go commands do not, so export
# the variables they need in your shell first.

# --- Docker Compose only ---
# PostgreSQL and Redis containers, and the host ports they publish. Compose also
# builds the API container's DATABASE_URL and REDIS_URL from these values, using
# the postgres and redis hostnames, so keep the passwords URL-safe.
POSTGRES_USER=playflow
POSTGRES_PASSWORD=playflow
POSTGRES_DB=playflow
POSTGRES_PORT=5432
REDIS_PASSWORD=playflow
REDIS_PORT=6379
# Host port for the containerized API. The container always listens on 8080.
API_PORT=8080

# --- Host-run Go commands only (go run ./cmd/api, Goose, integration tests) ---
# Compose ignores these for the API container: it sets APP_ENV=local and PORT=8080
# and builds its own URLs. If you change the credentials or ports above, update
# these URLs to match.
APP_ENV=local
PORT=8080
DATABASE_URL=postgres://playflow:playflow@localhost:5432/playflow?sslmode=disable
# redis:// is fine locally. staging/production require rediss:// (TLS), except
# to a loopback host such as a TLS-terminating sidecar on 127.0.0.1.
# Query parameters are rejected. The path is the database number.
REDIS_URL=redis://:playflow@localhost:6379/0

# --- Shared: the API container and host-run Go commands ---
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s
REDIS_POOL_SIZE=10
REDIS_CONNECT_TIMEOUT=5s
